{
  "name": "orbit-pad",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "A phone-to-PC controller with a native Windows Xbox 360 / XInput receiver",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "preview": "node server/index.js --dry-run",
    "test": "node --test",
    "test:android": "python scripts/test-rust-android.py",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "setup:gamepad": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-gamepad.ps1 -IncludeDriver"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  }
}
